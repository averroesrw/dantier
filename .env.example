# Reservation API base URL. Include /api suffix.
# For Cloudflare Worker deployment, use:
# VITE_RESERVATIONS_API_URL=https://your-worker-name.workers.dev/api
VITE_RESERVATIONS_API_URL=

# Resend configuration (use Cloudflare Pages secrets for production)
RESEND_FROM_EMAIL=
# RESEND_API_KEY should be stored as a Cloudflare Pages secret
